{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "build",
            "installDir": "install",
            "generator": "Ninja Multi-Config",
            "toolchainFile": "cmake/vcpkg/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "Launcher_BUILD_ARTIFACT": "$penv{ARTIFACT_NAME}",
                "Launcher_BUILD_PLATFORM": "$penv{BUILD_PLATFORM}",
                "Launcher_ENABLE_JAVA_DOWNLOADER": "ON",
                "ENABLE_LTO": "ON"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos",
            "displayName": "macOS",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macos_universal",
            "displayName": "macOS (Universal Binary)",
            "inherits": [
                "macos"
            ],
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
                "VCPKG_TARGET_TRIPLET": "universal-osx"
            }
        },
        {
            "name": "windows_mingw",
            "displayName": "Windows (MinGW)",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows_msvc",
            "displayName": "Windows (MSVC)",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "release_fast_linux",
            "displayName": "Linux (Release Fast, Stripped)",
            "description": "GCC/Clang max optimization, LTO, stripped symbols, no asserts. Targets x86-64-v3 (AVX2-class CPUs, ~2015+)",
            "inherits": [
                "linux"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -march=x86-64-v3 -fomit-frame-pointer -fno-plt -fvisibility=hidden -fmerge-all-constants",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=x86-64-v3 -fomit-frame-pointer -fno-plt -fvisibility=hidden -fmerge-all-constants",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-s",
                "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-s"
            }
        },
        {
            "name": "release_fast_macos_universal",
            "displayName": "macOS Universal (Release Fast, Stripped)",
            "description": "Clang max optimization, LTO, stripped symbols, no asserts. Keeps universal-binary arch/triplet from macos_universal.",
            "inherits": [
                "macos_universal"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -fomit-frame-pointer -fvisibility=hidden -fmerge-all-constants",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -fomit-frame-pointer -fvisibility=hidden -fmerge-all-constants",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-Wl,-S",
                "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-Wl,-S"
            }
        },
        {
            "name": "release_fast_windows_msvc",
            "displayName": "Windows MSVC (Release Fast, Stripped)",
            "description": "MSVC max optimization, whole-program LTCG, no PDBs/asserts. /arch:AVX2 is MSVC's equivalent to x86-64-v3",
            "inherits": [
                "windows_msvc"
            ],
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CMAKE_C_FLAGS_RELEASE": "/O2 /GL /DNDEBUG /Gw /Oi /arch:AVX2",
                "CMAKE_CXX_FLAGS_RELEASE": "/O2 /GL /DNDEBUG /Gw /Oi /arch:AVX2",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/LTCG /DEBUG:NONE",
                "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "/LTCG /DEBUG:NONE"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux",
            "displayName": "Linux",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "configurePreset": "linux"
        },
        {
            "name": "macos",
            "displayName": "macOS",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "configurePreset": "macos"
        },
        {
            "name": "macos_universal",
            "displayName": "macOS (Universal Binary)",
            "inherits": [
                "macos"
            ],
            "configurePreset": "macos_universal"
        },
        {
            "name": "windows_mingw",
            "displayName": "Windows (MinGW)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "configurePreset": "windows_mingw"
        },
        {
            "name": "windows_msvc",
            "displayName": "Windows (MSVC)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "configurePreset": "windows_msvc"
        },
        {
            "name": "release_fast_linux",
            "displayName": "Linux (Release Fast, Stripped)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "configurePreset": "release_fast_linux",
            "configuration": "Release"
        },
        {
            "name": "release_fast_macos_universal",
            "displayName": "macOS Universal (Release Fast, Stripped)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "configurePreset": "release_fast_macos_universal",
            "configuration": "Release"
        },
        {
            "name": "release_fast_windows_msvc",
            "displayName": "Windows MSVC (Release Fast, Stripped)",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "configurePreset": "release_fast_windows_msvc",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": {
                "outputOnFailure": true,
                "verbosity": "extra"
            },
            "execution": {
                "noTestsAction": "error"
            },
            "filter": {
                "exclude": {
                    "name": "^example64|example$"
                }
            }
        },
        {
            "name": "linux",
            "displayName": "Linux",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "configurePreset": "linux"
        },
        {
            "name": "macos",
            "displayName": "macOS",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "configurePreset": "macos"
        },
        {
            "name": "macos_universal",
            "displayName": "macOS (Universal Binary)",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "configurePreset": "macos_universal"
        },
        {
            "name": "windows_mingw",
            "displayName": "Windows (MinGW)",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "configurePreset": "windows_mingw"
        },
        {
            "name": "windows_msvc",
            "displayName": "Windows (MSVC)",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "configurePreset": "windows_msvc"
        },
        {
            "name": "release_fast_linux",
            "displayName": "Linux (Release Fast, Stripped)",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "configurePreset": "release_fast_linux"
        },
        {
            "name": "release_fast_macos_universal",
            "displayName": "macOS Universal (Release Fast, Stripped)",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "configurePreset": "release_fast_macos_universal"
        },
        {
            "name": "release_fast_windows_msvc",
            "displayName": "Windows MSVC (Release Fast, Stripped)",
            "inherits": [
                "base"
            ],
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "configurePreset": "release_fast_windows_msvc"
        }
    ]
}
